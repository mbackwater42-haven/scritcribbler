# scrit-recorder settings (copy to .env, chmod 600). Generate tokens with: openssl rand -hex 32
HOST=127.0.0.1
PORT=30010

# Token the Foundry module sends (module setting "Recorder token", GM browser only).
SCRIT_API_TOKEN=

# LiveKit project used by avclient-livekit.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Desktop Whisper/Ollama backend over HTTPS; same token goes in backend/.env.
BACKEND_URL=https://192.168.0.27:5443
BACKEND_TOKEN=
BACKEND_CA=/path/to/ca.crt

RECORDINGS_DIR=/mnt/foundryvtt/data/Data/scrit-cribbler/recordings
RECAPS_DIR=/mnt/foundryvtt/data/Data/scrit-cribbler/recaps
CHUNK_SECONDS=600

# Audio (.ogg) is deleted this many days after the recap is posted; transcripts and recaps
# are kept. 0 = keep forever. Sessions marked "Keep audio" in the panel are never swept.
AUDIO_RETENTION_DAYS=60
# When to look for expired audio: daily, or quarterly (first day of Jan/Apr/Jul/Oct).
AUDIO_SWEEP=daily
# Refuse to start recording with less free disk than this (GB).
MIN_FREE_GB=2
