# Scrit Cribbler backend (Windows workstation). Copy to .env.
BACKEND_TOKEN=
BIND=0.0.0.0
PORT=5443
TLS_CERT=certs/desktop.crt
TLS_KEY=certs/desktop.key
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral
OLLAMA_NUM_CTX=8192
WHISPER_MODEL=medium
WHISPER_COMPUTE=int8
OLLAMA_KEEP_ALIVE=30m

# Campaign knowledge base for GM lore Q&A (optional; unset = off). The folder holds
# <campaign>/index/<campaign>.json and <campaign>/glossary.tsv. Keep it OUT of the repo: it contains GM secrets.
# CAMPAIGNKB_DIR=C:\1\campaignkb
# KB_ANSWER_MODEL=llama3.1:8b
# KB_EMBED_MODEL=nomic-embed-text
